# Copia este archivo a .env.local para desarrollo: cp .env.example .env.local
#
# Sin estas variables configuradas, la app sigue funcionando en modo "dry-run":
# el formulario valida y responde normalmente, pero las solicitudes solo se
# registran en la consola del servidor en vez de guardarse en Google Sheets.
# Esto permite contribuir en UI, accesibilidad o textos sin necesitar acceso
# a la hoja de cálculo del equipo coordinador.
#
# NUNCA les pongas el prefijo NEXT_PUBLIC_: eso las expondría en el navegador.

# URL de la implementación del Apps Script (termina en /exec).
# Ver apps-script/README.md para cómo obtenerla.
APPS_SCRIPT_URL=

# Token compartido con el Apps Script (misma cadena que SHARED_TOKEN en las
# Propiedades del script). Genera uno con: openssl rand -hex 32
APPS_SCRIPT_TOKEN=
